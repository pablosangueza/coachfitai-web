@page "/checkout"
@using CoachFitAI.Shared.Web3Components
@using CoachFitAI.Web.Pages.Shared.Web3Components
@using CoachFitAI.Web.Services
@inject AppState State
@inject IPaymentService Payments
@inject NavigationManager Nav

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5 text-center">

      <h2 class="cf-h2 mb-4">Checkout</h2>

      @if (State.Intake is null)
      {
        <p>No intake found. <a href="generate">Go back</a></p>
      }
      else
      {
        <p class="fs-5">Plan price: <b>$1</b></p>
        <Web3PaymentWatcher Request="@Req"
                      Timeout="@TimeSpan.FromMinutes(20)"
                      OnPaymentConfirmed="HandlePaid" />
      }

    </div>
  </div>
</div>

@code {

    private string? DownloadUrl;

  private PaymentRequest Req = new PaymentRequest()
    {
        OrderId = Guid.NewGuid().ToString(),
        ExpectedAmount = 1.00m,
    };
  async Task Pay()
  {
    var order = await Payments.StartCheckoutAsync(7m);
    State.SetOrder(order);
    var ok = await Payments.ConfirmPaymentAsync(order.Id);
    if (ok) Nav.NavigateTo("thank-you");
  }

   private Task HandlePaid(PaymentResult result)
    {
        DownloadUrl = $"https://tu-servidor.com/download?order={Req.OrderId}&sig=...";
        Console.WriteLine($"Pago OK: {result.TransactionHash} {result.Amount} {result.From} -> {result.To}");
        StateHasChanged();
         Nav.NavigateTo("thank-you");
        return Task.CompletedTask;
    }
}
