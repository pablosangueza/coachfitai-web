@page "/plan"
@using System.Net.Http.Json

@inject HttpClient Http
@inject AppState State
@inject IJSRuntime JS

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

      <h2 class="cf-h2 text-center mb-4">Your Plan</h2>

      @if (State.Plan is null)
      {
        <p class="text-center">No plan yet.</p>
      }
      else
      {
        

        <!-- PDF section: load link, show spinner and email notice -->
        <div class="mt-4 p-3 border rounded">
          <h5>Download Plan (PDF)</h5>

          @if (isLoadingPdf)
          {
            <div class="d-flex align-items-center">
              <div class="spinner-border me-2" role="status" aria-hidden="true"></div>
              <div>Preparing PDF... please wait.</div>
            </div>
          }
          else if (!string.IsNullOrEmpty(PdfUrl))
          {
            <div>
              <a class="btn btn-outline-primary" href="@PdfUrl" target="_blank" rel="noopener">Open PDF</a>
              <span class="ms-2 text-muted small">You can also right-click → Save link as...</span>
            </div>
          }
          else
          {
            <div class="mb-2">
              <button class="btn btn-primary" @onclick="LoadPdf">Get PDF</button>
            </div>
          }

          <div class="mt-3 small text-muted">
            A copy of the plan will also be sent to your email
            @if (!string.IsNullOrWhiteSpace(State.Intake?.Email))
            {
              @( $" ({State.Intake.Email})" )
            }
            else
            {
              @( "(the email you provided at checkout)" )
            }
          </div>
        </div>

      }

    </div>
  </div>
</div>

@code {
  // ...existing code...
  private bool isLoadingPdf = false;
  private string? PdfUrl;

  private async Task LoadPdf()
  {
    if (isLoadingPdf || State.Plan is null) return;

    isLoadingPdf = true;
    PdfUrl = null;

    try
    {
      var resp = await Http.PostAsJsonAsync("https://localhost:7064/api/plan/pdf", State.Plan);

      if (!resp.IsSuccessStatusCode)
      {
        // handle error (log/show message)
        return;
      }

      var bytes = await resp.Content.ReadAsByteArrayAsync();
      var base64 = Convert.ToBase64String(bytes);

      // trigger client download
      await JS.InvokeVoidAsync("downloadFileFromBase64", "coachfitai-plan.pdf", base64);

      // Optionally provide a temporary public URL (skip if not available)
      // PdfUrl = $"data:application/pdf;base64,{base64}";
    }
    catch (Exception ex)
    {
      Console.WriteLine(ex.Message);
      // handle errors
    }
    finally
    {
      isLoadingPdf = false;
      StateHasChanged();
    }
  }
}